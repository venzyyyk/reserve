# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Database (M2b) -------------------------------------------------------
# Local, via docker compose up -d mongodb:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (Connect -> Drivers gives you this string):
# MONGODB_URI=mongodb+srv://supportreserv_db_user:<db_password>@cluster0.aayfbo5.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=reserve

# Leave MONGODB_URI empty to run on in-memory storage in development.
# A production build refuses to start without it — bookings would not survive
# a restart, and failing loudly beats losing them quietly.

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://reserve-topaz.vercel.app

# Super Admin panel. Defaults to "reserve-dev" in development; required in
# production.
# SUPERADMIN_PASSWORD=reservevenv21344sup

# --- Optional -------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
